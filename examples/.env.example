# Environment Variables for PowerScale RAG Connector examples.
# Edit this file to match your environment.

# Environmental settings for Hello World. Please copy using "cp .env.example .env"
# and then fill in with your own data

# PowerScale connection settings
ES_HOST_URL = "https://your-elasticsearch-host:9200"  # Elasticsearch host URL for MetadataIQ
ES_INDEX_NAME = "your-index-name"  # MetadataIQ index name
ES_API_KEY = "your-api-key"  # Elasticsearch API key (encoded)
VERIFY_SSL=True

# The FOLDER_PATH must be an absolute path on the PowerScale cluster
# beginning with "/ifs"; the metadata written to ElasticSearch by
# MetadataIQ and queried by this connector uses Powerscale absolute paths
# File scanning settings
FOLDER_PATH = "/ifs/path/to/your/data"

# LlamaIndex Reader settings (only used by LlamaIndex Readers)
INPUT_DIR = "/ifs/your/path"
INPUT_FILES = ["/ifs/your/path/file1.txt"]
EXCLUDE_FILES = ["/ifs/your/path/exclude.txt"]

# Nvidia NvIngest v2 settings
# Preferred naming convention (used in RAG vectorstore examples)
NV_INGEST_ENDPOINT = "localhost"  # NvIngest service hostname or IP
NV_INGEST_PORT = 7670  # NvIngest service port

# Vectorstore settings (for RAG vectorstore examples)
VECTORSTORE_INDEX = "rag_vectors"  # Elasticsearch index for vectorstore
VECTORSTORE_ES_URL = "http://localhost:9200"  # Elasticsearch URL for vectorstore

# NVIDIA NIM embeddings settings (for RAG vectorstore examples)
NVIDIA_EMBEDDING_URL = "http://your-nim-host:8000"  # NVIDIA NIM embeddings endpoint (do NOT include /v1)
NVIDIA_API_KEY = ""  # NVIDIA API key (leave blank for local NIM)
NVIDIA_EMBEDDING_MODEL = "nvidia/llama-nemotron-embed-1b-v2"  # Embedding model name

# Scan control
FORCE_SCAN = False # Scan all files, ignoring checkpoint

# Debug settings
DEBUG_MODE = False # Set to True for more verbose logging

# Diagnostic settings (used by examples/diagnose_metadataiq.py)
APP_NAME = "powerscale_rag_connector"  # Name used for the checkpoint document
APP_VERSION = 1  # Version used for the checkpoint document
# Set DATASET_NAME to use dataset scope instead of FOLDER_PATH/INPUT_FILES (leave empty to disable)
DATASET_NAME = ""
TOP_N = 10  # Number of recent events/documents to display
